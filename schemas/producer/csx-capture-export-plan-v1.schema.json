{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:csx-capture-export-plan:1",
  "title": "CSX capture producer export plan",
  "description": "Private producer input. Local source paths are never copied to public records.",
  "type": "object",
  "required": [
    "schema",
    "submissionId",
    "artifactId",
    "captureId",
    "recordedAt",
    "source",
    "artifact",
    "map",
    "runtime",
    "environment",
    "scenario",
    "treatment",
    "protocol",
    "privacy",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "name": "skyrim-render-map.csx-capture-export-plan",
        "major": 1,
        "minor": 0
      }
    },
    "submissionId": {
      "type": "string",
      "pattern": "^sub-[a-z0-9][a-z0-9.-]{7,127}$"
    },
    "artifactId": { "$ref": "#/$defs/recordId" },
    "captureId": { "$ref": "#/$defs/recordId" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "map": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/map"
    },
    "runtime": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/runtime"
    },
    "environment": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/environment"
    },
    "scenario": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/scenario"
    },
    "treatment": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/treatment"
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "privacy": {
      "$ref": "urn:skyrim-render-map:schema:performance-observation:1#/properties/privacy"
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]{0,17}(?:\\.[0-9]{1,9})?)$"
    },
    "source": {
      "type": "object",
      "required": ["kind", "manifestPath"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "csx-screenshot-sequence-v1" },
        "manifestPath": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["locationTemplate", "license", "retentionClass"],
      "additionalProperties": false,
      "properties": {
        "locationTemplate": {
          "type": "string",
          "description": "Stable public HTTPS URL containing exactly one {sha256} placeholder.",
          "pattern": "^https://[^?#]*\\{sha256\\}[^?#]*$"
        },
        "license": { "enum": ["CC-BY-SA-4.0", "CC0-1.0"] },
        "retentionClass": {
          "enum": ["release-asset", "oci-artifact", "object-storage", "external"]
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "name",
        "version",
        "artifactSha256",
        "frameRateHz",
        "timingMode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "frameRateHz": { "$ref": "#/$defs/positiveDecimal" },
        "timingMode": { "enum": ["fixed-step", "wall-clock", "unknown"] }
      }
    }
  }
}
