{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:entity:1",
  "title": "Skyrim render-map entity declaration",
  "type": "object",
  "required": ["schema", "entityId", "kind", "label", "sourceRefs", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "name": "skyrim-render-map.entity",
        "major": 1,
        "minor": 0
      }
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
    },
    "label": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
