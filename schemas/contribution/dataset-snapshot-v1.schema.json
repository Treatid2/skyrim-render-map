{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:dataset-snapshot:1",
  "title": "Generated Skyrim render-map dataset snapshot",
  "type": "object",
  "required": [
    "snapshotId",
    "mapSnapshotId",
    "schema",
    "generatedBy",
    "sourceRevision",
    "submissions",
    "entities",
    "assertions",
    "conflicts",
    "resolutions",
    "performanceObservations",
    "performanceGroups",
    "performanceSignals",
    "optimizationExperiments",
    "optimizationSurfaces",
    "statistics"
  ],
  "additionalProperties": false,
  "properties": {
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot-[a-f0-9]{64}$"
    },
    "mapSnapshotId": {
      "type": "string",
      "pattern": "^map-snapshot-[a-f0-9]{64}$"
    },
    "schema": {
      "const": {
        "name": "skyrim-render-map.dataset-snapshot",
        "major": 1,
        "minor": 3
      }
    },
    "generatedBy": {
      "const": {
        "name": "skyrim-render-map.compile-dataset",
        "version": "1.3.0"
      }
    },
    "sourceRevision": { "type": ["string", "null"] },
    "submissions": { "type": "array", "items": { "type": "object" } },
    "entities": { "type": "array", "items": { "type": "object" } },
    "assertions": { "type": "array", "items": { "type": "object" } },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "conflict-v1.schema.json" }
    },
    "resolutions": { "type": "array", "items": { "type": "object" } },
    "performanceObservations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "performanceGroups": {
      "type": "array",
      "items": { "type": "object" }
    },
    "performanceSignals": {
      "type": "array",
      "items": { "type": "object" }
    },
    "optimizationExperiments": {
      "type": "array",
      "items": { "type": "object" }
    },
    "optimizationSurfaces": {
      "type": "array",
      "items": { "type": "object" }
    },
    "statistics": {
      "type": "object",
      "required": [
        "submissionCount",
        "entityCount",
        "assertionCount",
        "conflictCount",
        "openConflictCount",
        "resolutionCount",
        "performanceObservationCount",
        "aggregateEligiblePerformanceObservationCount",
        "performanceGroupCount",
        "performanceSignalCount",
        "optimizationExperimentCount",
        "optimizationSurfaceCount"
      ],
      "additionalProperties": false,
      "properties": {
        "submissionCount": { "type": "integer", "minimum": 0 },
        "entityCount": { "type": "integer", "minimum": 0 },
        "assertionCount": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 },
        "openConflictCount": { "type": "integer", "minimum": 0 },
        "resolutionCount": { "type": "integer", "minimum": 0 },
        "performanceObservationCount": { "type": "integer", "minimum": 0 },
        "aggregateEligiblePerformanceObservationCount": {
          "type": "integer",
          "minimum": 0
        },
        "performanceGroupCount": { "type": "integer", "minimum": 0 },
        "performanceSignalCount": { "type": "integer", "minimum": 0 },
        "optimizationExperimentCount": { "type": "integer", "minimum": 0 },
        "optimizationSurfaceCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
