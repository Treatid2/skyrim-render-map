{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:resolution:1",
  "title": "Skyrim render-map conflict resolution",
  "type": "object",
  "required": [
    "schema",
    "resolutionId",
    "conflictId",
    "participantRefs",
    "outcome",
    "effectiveAssertionRefs",
    "evidenceRefs",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "name": "skyrim-render-map.resolution",
        "major": 1,
        "minor": 0
      }
    },
    "resolutionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "conflictId": {
      "type": "string",
      "pattern": "^conflict-[a-f0-9]{64}$"
    },
    "participantRefs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outcome": {
      "enum": [
        "narrowed-applicability",
        "supersedes",
        "unsupported",
        "aliases",
        "unresolved"
      ]
    },
    "effectiveAssertionRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string", "minLength": 1 }
  }
}
