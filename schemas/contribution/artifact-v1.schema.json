{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:artifact:1",
  "title": "Content-addressed external evidence artifact",
  "type": "object",
  "required": [
    "schema", "artifactId", "artifactSha256", "mediaType", "contentKind",
    "encoding", "byteLength", "expandedByteLength", "license",
    "retentionClass", "locations", "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": { "name": "skyrim-render-map.artifact", "major": 1, "minor": 0 }
    },
    "artifactId": { "$ref": "visual-comparison-v1.schema.json#/$defs/recordId" },
    "artifactSha256": { "$ref": "visual-comparison-v1.schema.json#/$defs/sha256" },
    "mediaType": { "type": "string", "minLength": 1 },
    "contentKind": {
      "enum": ["stereo-sequence", "mono-sequence", "still-pair", "capture-manifest", "other"]
    },
    "encoding": { "enum": ["identity", "zip", "zstd"] },
    "byteLength": { "type": "integer", "minimum": 1 },
    "expandedByteLength": { "type": "integer", "minimum": 1 },
    "license": { "enum": ["CC-BY-SA-4.0", "CC0-1.0"] },
    "retentionClass": {
      "enum": ["release-asset", "oci-artifact", "object-storage", "repository-inline", "external"]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://[^?#]+$"
      }
    },
    "notes": { "type": "string" }
  }
}
