{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyrim-render-map:schema:optimization-experiment:1",
  "title": "Skyrim render-map optimization experiment",
  "type": "object",
  "required": [
    "schema",
    "experimentId",
    "recordedAt",
    "map",
    "producer",
    "search",
    "axes",
    "objectives",
    "constraints",
    "candidates",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "name": "skyrim-render-map.optimization-experiment",
        "major": 1,
        "minor": 0
      }
    },
    "experimentId": { "$ref": "#/$defs/recordId" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "map": {
      "type": "object",
      "required": ["mapSnapshotId", "nodeRefs"],
      "additionalProperties": false,
      "properties": {
        "mapSnapshotId": {
          "type": "string",
          "pattern": "^map-snapshot-[a-f0-9]{64}$"
        },
        "nodeRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "producer": { "$ref": "#/$defs/tool" },
    "search": {
      "type": "object",
      "required": [
        "algorithm",
        "algorithmVersion",
        "randomSeedSha256",
        "requestedCandidateCount"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "algorithmVersion": { "type": "string", "minLength": 1 },
        "randomSeedSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "requestedCandidateCount": { "type": "integer", "minimum": 1 }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axis" }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/objective" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,9})?$"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "artifactSha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "axis": {
      "type": "object",
      "required": [
        "axisId",
        "label",
        "mapNodeRef",
        "settingPath",
        "valueType",
        "domain"
      ],
      "additionalProperties": false,
      "properties": {
        "axisId": { "$ref": "#/$defs/recordId" },
        "label": { "type": "string", "minLength": 1 },
        "mapNodeRef": { "type": "string", "minLength": 1 },
        "settingPath": { "type": "string", "minLength": 1 },
        "valueType": {
          "enum": ["boolean", "integer", "decimal", "categorical"]
        },
        "domain": {
          "oneOf": [
            { "$ref": "#/$defs/booleanDomain" },
            { "$ref": "#/$defs/integerDomain" },
            { "$ref": "#/$defs/decimalDomain" },
            { "$ref": "#/$defs/categoricalDomain" }
          ]
        }
      }
    },
    "booleanDomain": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "const": "boolean" } }
    },
    "integerDomain": {
      "type": "object",
      "required": ["kind", "minimum", "maximum", "step"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "integer" },
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "step": { "type": "integer", "minimum": 1 }
      }
    },
    "decimalDomain": {
      "type": "object",
      "required": ["kind", "minimum", "maximum", "step"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "decimal" },
        "minimum": { "$ref": "#/$defs/decimal" },
        "maximum": { "$ref": "#/$defs/decimal" },
        "step": { "$ref": "#/$defs/decimal" }
      }
    },
    "categoricalDomain": {
      "type": "object",
      "required": ["kind", "values"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "categorical" },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "objectiveId",
        "label",
        "metric",
        "unit",
        "direction",
        "scope",
        "scopeRefs",
        "reducer",
        "dominanceEpsilon"
      ],
      "additionalProperties": false,
      "properties": {
        "objectiveId": { "$ref": "#/$defs/recordId" },
        "label": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "unit": {
          "enum": [
            "milliseconds",
            "microseconds",
            "frames-per-second",
            "percent",
            "count"
          ]
        },
        "direction": { "enum": ["minimize", "maximize"] },
        "scope": {
          "enum": ["whole-frame", "map-node", "map-node-set", "process", "other"]
        },
        "scopeRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reducer": { "const": "median-of-observation-medians" },
        "dominanceEpsilon": { "$ref": "#/$defs/decimal" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": { "enum": ["map-node", "map-node-set"] }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": {
              "scopeRefs": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["constraintId", "objectiveId", "operator", "threshold"],
      "additionalProperties": false,
      "properties": {
        "constraintId": { "$ref": "#/$defs/recordId" },
        "objectiveId": { "$ref": "#/$defs/recordId" },
        "operator": { "enum": ["at-most", "at-least"] },
        "threshold": { "$ref": "#/$defs/decimal" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["axisId", "value"],
      "additionalProperties": false,
      "properties": {
        "axisId": { "$ref": "#/$defs/recordId" },
        "value": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "integer", "minimum": 0 },
            { "$ref": "#/$defs/decimal" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    },
    "objectiveObservations": {
      "type": "object",
      "required": ["objectiveId", "observationRefs"],
      "additionalProperties": false,
      "properties": {
        "objectiveId": { "$ref": "#/$defs/recordId" },
        "observationRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidateId",
        "label",
        "treatmentSha256",
        "outcome",
        "failureKind",
        "parameters",
        "objectiveObservations",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "candidateId": { "$ref": "#/$defs/recordId" },
        "label": { "type": "string", "minLength": 1 },
        "treatmentSha256": { "$ref": "#/$defs/sha256" },
        "outcome": {
          "enum": ["completed", "failed", "incomplete", "rejected"]
        },
        "failureKind": { "type": ["string", "null"] },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "objectiveObservations": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectiveObservations" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "completed" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": { "failureKind": { "type": "null" } }
          },
          "else": {
            "properties": {
              "failureKind": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
